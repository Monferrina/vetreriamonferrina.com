# npm 11 o successivo (il build su Vercel): uno script d'installazione di un pacchetto non
# elencato in allowScripts di package.json fa fallire l'install invece di girare con un avviso.
# npm 10 (CI e locale, Node 22) lo ignora. Misurato il 12/10/2026 (ESTRICTALLOWSCRIPTS).
strict-allow-scripts=true
