# Il locale anticipa, la CI decide: qui solo i controlli veloci (tipi, unit,
# Semgrep sui file cambiati). Build ed E2E restano in CI.
npm run check
npm test

if ! command -v semgrep >/dev/null 2>&1; then
  echo "pre-push: semgrep non installato, salto la scansione (la fa la CI)"
  exit 0
fi

# $1 è il remote del push: si confronta con il suo main.
base=$(git merge-base HEAD "$1/main" 2>/dev/null) || {
  echo "pre-push: $1/main non trovato, salto la scansione Semgrep"
  exit 0
}
# Le prove delle regole in .semgrep/ contengono apposta i casi da segnalare.
files=$(git diff --name-only --diff-filter=ACMR "$base" HEAD | grep -v '^\.semgrep/' || true)
[ -z "$files" ] && exit 0
# Le regole della repo bloccano, come il job Semgrep di sicurezza.yml; p/default
# (la base della scansione della piattaforma) solo avvisa, perché lì non blocca.
# Un percorso per parola: nessun file della repo ha spazi.
# shellcheck disable=SC2086
semgrep scan --config .semgrep --error --metrics off --quiet $files
# shellcheck disable=SC2086
semgrep scan --config p/default --metrics off --quiet $files
