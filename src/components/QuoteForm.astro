---
// src/components/QuoteForm.astro
// Interactive quote request form with client-side validation,
// honeypot anti-spam, and fetch-based submission. method="post" keeps the fields out of
// the URL when the script does not run (JS off, script error, CSP block). The page is static,
// so a native POST gets an empty 405 (measured in production, 2026-10-07): the submit button
// therefore starts disabled and only the script enables it, so nothing leaves the browser
// without it (WHATWG: implicit submission clicks the default button only if not disabled),
// and #form-nojs keeps the phone and email in view until the script hides it.
import { services, categories, type CategoryKey } from '../data/services';
import { email, emailHref, phone, phoneHref } from '../data/contatti';

const categoryKeys = Object.keys(categories) as CategoryKey[];
---

<div
  id="form-guidelines"
  class="mb-6 rounded-lg border border-primary/20 bg-primary/5 p-4 text-sm text-neutral-700"
>
  <p class="font-semibold text-primary">Come compilare il form</p>
  <ul class="mt-2 list-inside list-disc space-y-1">
    <li>Descrivi il lavoro nel modo pi&ugrave; dettagliato possibile</li>
    <li>Indica le misure approssimative (anche a occhio, ci pensiamo noi a verificare)</li>
    <li>Pi&ugrave; dettagli fornisci, pi&ugrave; preciso sar&agrave; il preventivo</li>
  </ul>
</div>

<form id="quote-form" method="post" novalidate class="space-y-6">
  <div class="absolute -left-[9999px] opacity-0" aria-hidden="true">
    <label for="website">Non compilare questo campo</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div>
    <label for="name" class="block text-sm font-medium text-neutral-800">
      Nome e cognome <span class="text-error">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      aria-required="true"
      aria-describedby="name-error"
      minlength="2"
      maxlength="100"
      autocomplete="name"
      class="mt-1 block w-full rounded-lg border border-neutral-200 bg-surface px-4 py-2.5 text-neutral-800 shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      placeholder="es. Mario Rossi"
    />
    <p id="name-error" data-error="name" class="mt-1 hidden text-sm text-error"></p>
  </div>

  <div>
    <label for="phone" class="block text-sm font-medium text-neutral-800">
      Telefono <span class="text-error">*</span>
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      required
      aria-required="true"
      aria-describedby="phone-error"
      autocomplete="tel"
      class="mt-1 block w-full rounded-lg border border-neutral-200 bg-surface px-4 py-2.5 text-neutral-800 shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      placeholder="es. +39 0142 123456"
    />
    <p id="phone-error" data-error="phone" class="mt-1 hidden text-sm text-error"></p>
  </div>

  <div>
    <label for="email" class="block text-sm font-medium text-neutral-800">
      Email <span class="text-error">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      aria-required="true"
      aria-describedby="email-error"
      autocomplete="email"
      class="mt-1 block w-full rounded-lg border border-neutral-200 bg-surface px-4 py-2.5 text-neutral-800 shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      placeholder="es. mario@esempio.it"
    />
    <p id="email-error" data-error="email" class="mt-1 hidden text-sm text-error"></p>
  </div>

  <div>
    <label for="serviceType" class="block text-sm font-medium text-neutral-800">
      Tipo di lavoro <span class="text-error">*</span>
    </label>
    <select
      id="serviceType"
      name="serviceType"
      required
      aria-required="true"
      aria-describedby="serviceType-error"
      class="mt-1 block w-full rounded-lg border border-neutral-200 bg-surface px-4 py-2.5 text-neutral-800 shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
    >
      <option value="">— Seleziona —</option>
      {
        categoryKeys.map((cat) => (
          <optgroup label={categories[cat]}>
            {services
              .filter((s) => s.category === cat)
              .map((s) => (
                <option value={s.slug}>{s.name}</option>
              ))}
          </optgroup>
        ))
      }
      <option value="altro">Altro</option>
    </select>
    <p id="serviceType-error" data-error="serviceType" class="mt-1 hidden text-sm text-error"></p>
  </div>

  <div>
    <label for="description" class="block text-sm font-medium text-neutral-800">
      Descrizione del lavoro <span class="text-error">*</span>
    </label>
    <textarea
      id="description"
      name="description"
      rows="4"
      required
      aria-required="true"
      aria-describedby="description-error"
      minlength="10"
      maxlength="2000"
      class="mt-1 block w-full rounded-lg border border-neutral-200 bg-surface px-4 py-2.5 text-neutral-800 shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      placeholder="Descrivi il lavoro di cui hai bisogno: tipo di vetro, dove va installato, eventuali preferenze..."
    ></textarea>
    <p id="description-error" data-error="description" class="mt-1 hidden text-sm text-error"></p>
  </div>

  <div>
    <label for="measurements" class="block text-sm font-medium text-neutral-800">
      Misure approssimative <span class="text-error">*</span>
    </label>
    <input
      type="text"
      id="measurements"
      name="measurements"
      required
      aria-required="true"
      aria-describedby="measurements-error"
      minlength="3"
      maxlength="500"
      class="mt-1 block w-full rounded-lg border border-neutral-200 bg-surface px-4 py-2.5 text-neutral-800 shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      placeholder="es. 120x80 cm, altezza 200 cm"
    />
    <p id="measurements-error" data-error="measurements" class="mt-1 hidden text-sm text-error"></p>
  </div>

  <div>
    <label for="privacy" class="flex items-start gap-3 cursor-pointer">
      <input
        type="checkbox"
        id="privacy"
        name="privacy"
        aria-required="true"
        aria-describedby="privacy-error"
        class="mt-0.5 h-5 w-5 rounded border-neutral-200 text-primary focus:ring-primary/20"
      />
      <span class="text-sm text-neutral-800">
        Acconsento al trattamento dei dati personali come descritto nella
        <a href="/privacy" class="text-primary underline hover:text-primary-dark">Privacy Policy</a>
        <span class="text-error">*</span>
      </span>
    </label>
    <p id="privacy-error" data-error="privacy" class="mt-1 hidden text-sm text-error"></p>
  </div>

  <div>
    <button
      type="submit"
      id="submit-btn"
      disabled
      class="inline-flex items-center justify-center gap-2 rounded-full bg-secondary-dark px-8 py-3.5 text-base font-semibold text-white shadow-lg transition-colors hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-secondary-light focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
    >
      <span id="submit-text">Invia richiesta</span>
      <svg
        id="submit-spinner"
        class="hidden h-5 w-5 animate-spin"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
        ></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
        ></path>
      </svg>
    </button>
    {
      /* Sotto il pulsante, non sopra il form: quando lo script lo nasconde non sposta niente
        nella parte visibile al caricamento (CLS). */
    }
    <p id="form-nojs" class="mt-3 text-sm text-neutral-700">
      Se il pulsante resta disattivato, chiamaci al
      <a href={phoneHref} class="font-medium text-primary underline">{phone}</a>
      o scrivici a
      <a href={emailHref} class="font-medium text-primary underline">{email}</a>.
    </p>
  </div>

  <div
    id="form-success"
    class="hidden rounded-lg border border-success/30 bg-success/10 p-6 text-center"
    role="alert"
    tabindex="-1"
  >
    <svg
      class="mx-auto mb-3 h-12 w-12 text-success"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <p class="text-lg font-semibold text-success">Richiesta inviata con successo!</p>
    <p class="mt-2 text-sm text-neutral-600">
      Ti ricontatteremo al pi&ugrave; presto. Controlla anche la cartella spam.
    </p>
  </div>

  <div
    id="form-error"
    class="hidden rounded-lg border border-error/30 bg-error/10 p-6 text-center"
    role="alert"
    tabindex="-1"
  >
    <svg
      class="mx-auto mb-3 h-12 w-12 text-error"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <p class="text-lg font-semibold text-error" id="form-error-message">Errore durante l'invio.</p>
    <p class="mt-2 text-sm text-neutral-600">
      Puoi riprovare oppure contattarci direttamente al telefono.
    </p>
    <button
      type="button"
      id="retry-btn"
      class="mt-4 inline-flex items-center gap-2 rounded-full border border-error/30 px-6 py-2 text-sm font-medium text-error transition-colors hover:bg-error/10 focus:outline-none focus:ring-2 focus:ring-error/20"
    >
      Riprova
    </button>
  </div>
</form>

<script>
  // Le stesse regole del server (src/lib/validation.ts), non una copia che diverge. Il server
  // valida dopo sanitizeFormData (fa il trim): se cambia qualcosa
  // puo' ancora rispondere 422, e quegli errori li mostra showErrors.
  import { validateQuoteForm, VALID_SERVICE_TYPES, type ValidationError } from '../lib/validation';
  import { submitQuote } from '../lib/quote-submit';

  const KNOWN_FIELDS = [
    'name',
    'phone',
    'email',
    'serviceType',
    'description',
    'measurements',
    'privacy',
  ];

  function showErrors(errors: ValidationError[]) {
    // Clear all previous errors
    document.querySelectorAll('[data-error]').forEach((el) => {
      el.classList.add('hidden');
      el.textContent = '';
    });
    // aria-invalid dice al lettore di schermo quale campo e' sbagliato (WCAG 3.3.1).
    document
      .querySelectorAll('#quote-form [aria-invalid]')
      .forEach((el) => el.removeAttribute('aria-invalid'));

    // Il focus va al primo campo in errore anche per i 422 del server: senza, l'errore restava
    // lontano dal pulsante. Dentro #quote-form: [name="description"] da solo prende il
    // <meta name="description"> dell'head.
    let focused = false;
    for (const err of errors) {
      // Only allow known field names to prevent selector injection
      if (!KNOWN_FIELDS.includes(err.field)) continue;
      const el = document.querySelector(`[data-error="${err.field}"]`);
      if (el) {
        el.textContent = err.message;
        el.classList.remove('hidden');
      }
      const input = document.querySelector<HTMLElement>(`#quote-form [name="${err.field}"]`);
      input?.setAttribute('aria-invalid', 'true');
      if (!focused && input) {
        // Gia' a fuoco (Invio dentro il campo sbagliato): focus() non fa niente e il lettore di
        // schermo non rilegge l'errore, che non e' una regione live. blur() lo fa rileggere.
        if (document.activeElement === input) input.blur();
        input.focus();
        focused = true;
      }
    }
  }

  function setLoading(loading: boolean) {
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const text = document.getElementById('submit-text') as HTMLSpanElement;
    const spinner = document.getElementById('submit-spinner') as unknown as SVGElement;

    btn.disabled = loading;
    if (loading) {
      text.textContent = 'Invio in corso...';
      spinner.classList.remove('hidden');
    } else {
      text.textContent = 'Invia richiesta';
      spinner.classList.add('hidden');
    }
  }

  function scrollToElement(el: HTMLElement) {
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function showSuccess() {
    const form = document.getElementById('quote-form') as HTMLFormElement;
    const success = document.getElementById('form-success') as HTMLDivElement;
    const error = document.getElementById('form-error') as HTMLDivElement;
    const guidelines = document.getElementById('form-guidelines') as HTMLDivElement;

    // Hide form fields and guidelines, show success
    const fieldsets = form.querySelectorAll(':scope > div:not(#form-success):not(#form-error)');
    fieldsets.forEach((el) => (el as HTMLElement).classList.add('hidden'));
    guidelines.classList.add('hidden');
    error.classList.add('hidden');
    success.classList.remove('hidden');
    success.focus();
    scrollToElement(success);
  }

  function showGlobalError(message: string) {
    const error = document.getElementById('form-error') as HTMLDivElement;
    const errorMsg = document.getElementById('form-error-message') as HTMLParagraphElement;
    errorMsg.textContent = message;
    error.classList.remove('hidden');
    error.focus();
    scrollToElement(error);
  }

  // Pre-select service from URL query param
  function preSelectService() {
    const params = new URLSearchParams(window.location.search);
    const servizio = params.get('servizio');
    if (servizio && VALID_SERVICE_TYPES.includes(servizio)) {
      const select = document.querySelector('[name="serviceType"]') as HTMLSelectElement;
      if (select) {
        select.value = servizio;
      }
    }
  }

  // Initialize
  preSelectService();

  // Retry button: hide error and let user try again
  const retryBtn = document.getElementById('retry-btn') as HTMLButtonElement;
  retryBtn.addEventListener('click', () => {
    const errorDiv = document.getElementById('form-error') as HTMLDivElement;
    errorDiv.classList.add('hidden');
    const firstField = document.querySelector('[name="name"]') as HTMLInputElement;
    firstField?.focus();
    scrollToElement(firstField);
  });

  const form = document.getElementById('quote-form') as HTMLFormElement;
  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();

    // Hide previous global error
    const errorDiv = document.getElementById('form-error') as HTMLDivElement;
    errorDiv.classList.add('hidden');

    const formData = {
      name: (form.querySelector('[name="name"]') as HTMLInputElement).value,
      phone: (form.querySelector('[name="phone"]') as HTMLInputElement).value,
      email: (form.querySelector('[name="email"]') as HTMLInputElement).value,
      serviceType: (form.querySelector('[name="serviceType"]') as HTMLSelectElement).value,
      description: (form.querySelector('[name="description"]') as HTMLTextAreaElement).value,
      measurements: (form.querySelector('[name="measurements"]') as HTMLInputElement).value,
      privacy: (form.querySelector('[name="privacy"]') as HTMLInputElement).checked,
      honeypot: (form.querySelector('[name="website"]') as HTMLInputElement).value,
    };

    // L'honeypot qui non si valida: con il campo pieno il server risponde 200 senza inviare,
    // e il bot deve ricevere la stessa risposta di un invio vero.
    const errors = validateQuoteForm({ ...formData, honeypot: '' });
    showErrors(errors);
    if (errors.length > 0) return;

    setLoading(true);
    // Import dinamico: solo all'errore. In produzione e' il modulo gia' caricato dall'init di
    // Sentry; dove l'integrazione e' spenta (preview, dev) l'SDK resta fuori dal bundle della
    // pagina (astro.config.mjs) e captureException, senza init, non manda niente.
    const esito = await submitQuote(formData, {
      report: (err) => void import('@sentry/astro').then((Sentry) => Sentry.captureException(err)),
    });
    setLoading(false);

    if (esito.kind === 'success') showSuccess();
    else if (esito.kind === 'fieldErrors') showErrors(esito.errors);
    else showGlobalError(esito.message);
  });

  // Ultima riga (perche': commento in testa al file).
  (document.getElementById('submit-btn') as HTMLButtonElement).disabled = false;
  document.getElementById('form-nojs')?.classList.add('hidden');
</script>
