---
// src/components/BottomNav.astro
// Fixed bottom tab bar for mobile — replaces hamburger menu.
// Visible only on screens below md breakpoint.
// Respects safe areas on all devices (iPhone notch, Android gesture nav).

const pathname = Astro.url.pathname;

const tabs = [
  {
    href: '/',
    label: 'Home',
    icon: 'home',
  },
  {
    href: '/servizi',
    label: 'Servizi',
    icon: 'servizi',
  },
  {
    href: '/galleria',
    label: 'Galleria',
    icon: 'galleria',
  },
  {
    href: '/contatti',
    label: 'Contatti',
    icon: 'contatti',
  },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

// Posizione iniziale della bolla nell'HTML, non dallo script: nel cambio pagina Safari (iOS 26)
// disegna la pagina nuova prima che lo script giri, e la bolla compariva come una riga di 2 px
// che poi si allargava (AU1, video da iPhone 15 Pro). Le quattro voci sono larghe uguali.
const activeIndex = tabs.findIndex((tab) => isActive(tab.href));
const bubblePosition = ['left-0', 'left-1/4', 'left-1/2', 'left-3/4'][activeIndex] ?? 'opacity-0';
---

<!--
  after: lo sfondo continua sotto la barra. Safari 26 colora la zona dietro la sua barra degli
  indirizzi solo se c'è un elemento fixed attaccato a quel bordo (WebKit, bug 301756); durante la
  transizione tra pagine ci sono solo le immagini catturate, e lì si vedeva il contenuto della
  pagina per ~150 ms (AU1, video da iPhone 15 Pro). L'immagine catturata della barra comprende
  anche questo prolungamento, e copre la zona.
-->
<nav
  class="fixed bottom-0 left-0 right-0 z-50 border-t border-neutral-200 bg-neutral-50/95 pb-[env(safe-area-inset-bottom,0px)] backdrop-blur-md [transform:translateZ(0)] [view-transition-name:bottom-nav] after:absolute after:inset-x-0 after:top-full after:h-40 after:bg-neutral-50/95 md:hidden"
  aria-label="Navigazione rapida"
  data-bottom-nav
>
  <div class="relative flex h-14 items-center justify-around">
    <span
      data-nav-bubble
      class:list={[
        'pointer-events-none absolute top-1 h-12 w-1/4 rounded-2xl border border-white/25 bg-white/15 shadow-[0_2px_12px_rgb(0_0_0/0.06),inset_0_1px_0_rgb(255_255_255/0.2)] backdrop-blur-lg backdrop-saturate-150 transition-[left,width] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] motion-reduce:transition-none',
        bubblePosition,
      ]}
      aria-hidden="true"></span>
    {
      tabs.map((tab) => (
        <a
          href={tab.href}
          class:list={[
            'relative flex flex-col items-center justify-center gap-0.5 px-2 py-1.5 text-[10px] font-medium transition-colors min-w-0 w-full min-h-[44px]',
            isActive(tab.href) ? 'text-primary' : 'text-neutral-600',
          ]}
          aria-current={isActive(tab.href) ? 'page' : undefined}
        >
          <span class="relative">
            {tab.icon === 'home' && (
              <svg
                class="h-[22px] w-[22px]"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width={isActive(tab.href) ? '2' : '1.5'}
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
                />
              </svg>
            )}
            {tab.icon === 'servizi' && (
              <svg
                class="h-[22px] w-[22px]"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width={isActive(tab.href) ? '2' : '1.5'}
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085"
                />
              </svg>
            )}
            {tab.icon === 'galleria' && (
              <svg
                class="h-[22px] w-[22px]"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width={isActive(tab.href) ? '2' : '1.5'}
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
                />
              </svg>
            )}
            {tab.icon === 'contatti' && (
              <svg
                class="h-[22px] w-[22px]"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width={isActive(tab.href) ? '2' : '1.5'}
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                />
              </svg>
            )}
          </span>
          <span class="truncate">{tab.label}</span>
        </a>
      ))
    }
  </div>
</nav>

<style>
  /* Tema scuro: la bolla bianca al 15% schiarisce il fondo della voce attiva, e il primario ci
     stava a 4,35:1 (axe in modalità mobile, AU1); il primario chiaro arriva a 5,6:1. */
  :global([data-theme='dark']) a[aria-current='page'] {
    color: var(--color-primary-light);
  }
</style>

<script>
  function initNavBubble(): void {
    const nav = document.querySelector<HTMLElement>('[data-bottom-nav]');
    const bubble = document.querySelector<HTMLElement>('[data-nav-bubble]');
    if (!nav || !bubble) return;

    const container = bubble.parentElement;
    if (!container) return;

    function moveBubbleTo(tab: HTMLAnchorElement): void {
      const containerRect = container!.getBoundingClientRect();
      const tabRect = tab.getBoundingClientRect();

      bubble!.style.left = `${tabRect.left - containerRect.left}px`;
      bubble!.style.width = `${tabRect.width}px`;
      bubble!.style.opacity = '1';
    }

    // Feedback immediato al tap: la bolla si sposta sulla voce toccata prima
    // che la nuova pagina arrivi dalla rete, così l'utente sa che l'input è
    // stato ricevuto e non ritocca il tasto.
    nav.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((tab) => {
      tab.addEventListener('click', () => moveBubbleTo(tab));
    });
  }

  initNavBubble();
</script>
