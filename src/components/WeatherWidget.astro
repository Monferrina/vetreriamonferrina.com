---
// src/components/WeatherWidget.astro
// Meteo di Casale Monferrato con un consiglio sui vetri. I dati arrivano da /api/meteo, che li
// prende da MET Norway (licenza CC BY 4.0: credito e link alla licenza obbligatori, qui sotto).
---

<div
  id="weather-widget"
  class="rounded-xl border border-neutral-200 bg-surface p-5 text-sm"
  aria-label="Meteo Casale Monferrato"
>
  <div class="flex items-center gap-3">
    <div id="weather-icon" class="text-3xl" aria-hidden="true"></div>
    <div>
      <p class="font-semibold text-neutral-800" id="weather-temp"></p>
      <p class="text-neutral-600" id="weather-desc"></p>
    </div>
  </div>
  <div id="weather-tip" class="mt-3 hidden rounded-lg bg-primary/5 px-3 py-2 text-primary"></div>
  <p class="mt-2 text-xs text-neutral-600">Casale Monferrato</p>
  <p class="mt-1 text-xs text-neutral-600">
    Dati meteo:
    <a
      class="underline"
      href="https://api.met.no/doc/License"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="MET Norway (si apre in una nuova scheda)">MET Norway</a
    >, licenza CC BY 4.0
  </p>
</div>

<script>
  // Script normale, non is:inline: così Astro lo hasha nel CSP (security.csp). Con define:vars
  // restava inline senza hash e il browser lo bloccava (misurato, CSP1).
  async function initWeather() {
    const widget = document.getElementById('weather-widget');
    if (!widget || widget.dataset.loaded) return;
    widget.dataset.loaded = 'true';

    try {
      const res = await fetch('/api/meteo');
      if (!res.ok) throw new Error('meteo non disponibile');
      const {
        temperatura: temp,
        umidita: humidity,
        vento: wind,
        icona,
        descrizione,
        pioggia,
        temporale,
      } = await res.json();

      document.getElementById('weather-icon')!.textContent = icona;
      document.getElementById('weather-temp')!.textContent =
        `${temp}°C · Umidità ${humidity}% · Vento ${wind} km/h`;
      document.getElementById('weather-desc')!.textContent = descrizione;

      // Smart glass tips based on weather
      const tipEl = document.getElementById('weather-tip')!;
      let tip = '';

      if (temp <= 5) {
        tip =
          '🥶 Giornata gelida — i vetrocamera tripli riducono la dispersione termica fino al 70%.';
      } else if (temp <= 12) {
        tip =
          '🌡️ Freddo in arrivo — un buon vetrocamera fa la differenza sulla bolletta del riscaldamento.';
      } else if (temp >= 32) {
        tip = "☀️ Caldo intenso — i vetri a controllo solare mantengono fresco l'ambiente.";
      } else if (temporale) {
        tip =
          '⛈️ Temporale — i vetri stratificati offrono massima resistenza agli agenti atmosferici.';
      } else if (pioggia) {
        tip = '🌧️ Pioggia — verifica le guarnizioni dei tuoi vetri e infissi.';
      } else if (humidity >= 80) {
        tip = '💧 Umidità alta — i vetrocamera prevengono la condensa sulle finestre.';
      }

      if (tip) {
        tipEl.textContent = tip;
        tipEl.classList.remove('hidden');
      }
    } catch {
      // Meteo non disponibile: il widget sparisce invece di restare vuoto.
      widget.style.display = 'none';
    }
  }

  // Carica il meteo solo quando il widget entra in viewport: il meteo non è
  // contenuto critico, così togliamo fetch + lavoro DOM dal percorso di load
  // iniziale (meglio INP/TBT su mobile). Fallback: se manca IntersectionObserver
  // carica subito.
  function scheduleWeather() {
    const widget = document.getElementById('weather-widget');
    if (!widget || widget.dataset.loaded) return;
    if (!('IntersectionObserver' in window)) {
      initWeather();
      return;
    }
    const observer = new IntersectionObserver(
      (entries, obs) => {
        if (entries[0].isIntersecting) {
          obs.disconnect();
          initWeather();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(widget);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleWeather);
  } else {
    scheduleWeather();
  }
</script>
