---
// src/components/Header.astro
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/chi-siamo', label: 'Chi siamo' },
  { href: '/servizi', label: 'Servizi' },
  { href: '/galleria', label: 'Galleria' },
  { href: '/contatti', label: 'Contatti' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header
  class="sticky top-0 z-50 border-b border-neutral-200 bg-neutral-50/80 backdrop-blur-md [view-transition-name:site-header]"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 lg:px-8">
    <a href="/" class="flex items-center gap-2" aria-label="Vetreria Monferrina">
      <img
        src="/images/logo-monogram.svg"
        alt=""
        width="42"
        height="48"
        class="h-9 w-auto lg:h-11"
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
      <span class="font-heading text-lg text-primary lg:text-xl"> Vetreria Monferrina </span>
    </a>

    <div class="flex items-center gap-1 lg:gap-2">
      <nav aria-label="Navigazione principale" class="hidden md:block">
        <ul class="flex items-center gap-1 lg:gap-2">
          {navLinks.map(({ href, label }) => <li>
            <a
              href={href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                isActive(href)
                  ? 'bg-primary/10 text-primary'
                  : 'text-neutral-700 hover:bg-neutral-100 hover:text-primary',
              ]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>)}
        </ul>
      </nav>

      <!-- AU1 (A10): il tema scuro si sceglie qui; lo script sta in BaseLayout (applyTheme). -->
      <button
        type="button"
        data-theme-toggle
        aria-label="Tema scuro"
        aria-pressed="false"
        class="flex h-10 w-10 items-center justify-center rounded-md text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-primary"
      >
        <svg
          class="h-5 w-5 in-data-[theme=dark]:hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
          ></path>
        </svg>
        <svg
          class="hidden h-5 w-5 in-data-[theme=dark]:block"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>
