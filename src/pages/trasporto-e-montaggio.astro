---
// src/pages/trasporto-e-montaggio.astro — Servizio trasporto, montaggio e smaltimento vetri.
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';
import ContattaciButton from '../components/ContattaciButton.astro';
export const prerender = true;

// Icone Heroicons (path d) riusate dalle card. Un'icona può avere più path.
