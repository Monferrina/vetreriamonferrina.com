const steps = [
  {
    icon: 'pin',
    title: 'Sopralluogo gratuito',
    text: 'Veniamo da te per prendere le misure e valutare insieme il lavoro. Senza impegno e senza costi.',
  },
  {
    icon: 'truck',
    title: 'Trasporto sicuro',
    text: 'Mezzi attrezzati per il trasporto di vetro di ogni dimensione. Protezione e cura in ogni fase, dal laboratorio al cantiere.',
  },
  {
    icon: 'wrench',
    title: 'Montaggio professionale',
    text: "Posa in opera a regola d'arte da parte dei nostri vetrai esperti. Pulizia del cantiere e collaudo finale inclusi.",
  },
];

const installTypes = [
  {
    name: 'Box doccia',
    description: 'Montaggio completo con fissaggi, cerniere e guarnizioni.',
    href: '/servizi',
  },
  {
    name: 'Parapetti in vetro',
    description: 'Installazione su balconi, terrazze e scale con fissaggi certificati.',
    href: '/servizi',
  },
  {
    name: 'Pensiline',
    description: 'Posa di pensiline in vetro per ingressi e spazi esterni.',
    href: '/servizi',
  },
  {
    name: 'Vetrine per negozi',
    description: 'Installazione di vetrine commerciali di qualsiasi dimensione.',
    href: '/servizi',
  },
  {
    name: 'Specchi e porte',
    description: 'Montaggio di specchi a parete e porte in vetro, scorrevoli o a battente.',
    href: '/servizi',
  },
  {
    name: 'Vetri camera e finestre',
    description: 'Sostituzione vetri e posa di vetrocamera per isolamento termico e acustico.',
    href: '/servizi',
  },
];

const zones = [
  {
    icon: 'pin',
    title: 'Piemonte',
    text: 'La nostra zona principale. Casale Monferrato, Alessandria, Asti, Torino, Vercelli, Novara e tutte le province.',
    badge: 'Sopralluogo gratuito',
  },
  {
    icon: 'pin',
    title: 'Lombardia',
    text: 'Gamma completa di servizi. Pavia, Milano, Vigevano, Voghera e province limitrofe.',
    badge: 'Sopralluogo gratuito',
  },
  {
    icon: 'truck',
    title: "Liguria e Valle d'Aosta",
    text: 'Disponibili per installazioni di grandi dimensioni e progetti speciali su preventivo.',
    badge: 'Progetti speciali',
  },
  {
    icon: 'globe',
    title: 'Estero',
    text: 'Esperienza anche oltre confine. Contattateci per valutare insieme il vostro progetto.',
    badge: 'Valutazione su richiesta',
  },
];

const guarantees = [
  {
    icon: 'document',
    title: 'Normativa UNI 7697',
    text: "Criteri di sicurezza per vetrate installate negli edifici. Ogni posa rispetta le prescrizioni sulla scelta del tipo di vetro in base alla destinazione d'uso.",
  },
  {
    icon: 'shield',
    title: 'D.Lgs. 81/2008',
    text: 'Sicurezza sul lavoro: i nostri operatori sono formati e dotati di tutti i dispositivi di protezione individuale previsti dalla legge.',
  },
  {
    icon: 'ce',
    title: 'Marcatura CE',
    text: 'Tutti i vetri che installiamo sono conformi alla marcatura CE secondo il Regolamento UE sui prodotti da costruzione (CPR 305/2011, in transizione verso il nuovo CPR 2024/3110).',
  },
  {
    icon: 'truck',
    title: 'Trasporto a norma',
    text: 'Mezzi attrezzati con cavalletti e sistemi di fissaggio certificati per il trasporto in sicurezza di lastre di vetro di qualsiasi dimensione.',
  },
  {
    icon: 'star',
    title: 'Garanzia sui lavori',
    text: 'Ogni installazione è coperta da garanzia. In caso di difetti di posa, interveniamo senza costi aggiuntivi.',
  },
  {
    icon: 'folder',
    title: 'Documentazione completa',
    text: 'Al termine di ogni lavoro rilasciamo tutta la documentazione necessaria: dichiarazione di conformità, schede tecniche e certificati dei materiali.',
  },
];
---

<BaseLayout
  title="Trasporto e montaggio"
  description="Trasporto sicuro e montaggio professionale del vetro a Casale Monferrato e in tutto il Piemonte. Sopralluogo gratuito, posa in opera a regola d'arte."
>
  <section class="bg-primary py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <GlassPanel class="max-w-3xl">
        <h1 class="font-heading text-4xl text-neutral-50 sm:text-5xl">Trasporto e montaggio</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-200">
          Dal nostro laboratorio a casa tua, con posa professionale. Ci occupiamo di tutto noi:
          misure, trasporto e installazione.
        </p>
      </GlassPanel>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 lg:px-8">
    <h2 class="font-heading text-3xl text-primary text-center sm:text-4xl mb-12" data-reveal>
      Come funziona
    </h2>

    <div class="grid gap-8 sm:grid-cols-3">
      {
        steps.map((step, i) => (
          <div data-reveal data-delay={String(i + 1)} class="group pb-1">
            <div class="glass-hover glass-reflect h-full rounded-2xl border border-neutral-200 bg-surface p-8 text-center shadow-sm transition-all duration-200 group-hover:-translate-y-1">
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
                <svg
                  class="h-8 w-8 text-primary"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  {ICONS[step.icon].map((d) => (
                    <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                  ))}
                </svg>
              </div>
              <span class="mt-4 inline-block rounded-full bg-primary px-3 py-1 text-sm font-semibold text-neutral-50">
                {i + 1}
              </span>
              <h3 class="mt-3 font-heading text-xl text-primary">{step.title}</h3>
              <p class="mt-2 text-neutral-800">{step.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-neutral-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <h2 class="font-heading text-3xl text-primary text-center sm:text-4xl mb-4" data-reveal>
        Cosa installiamo
      </h2>
      <p
        class="mx-auto mt-4 max-w-2xl text-center text-lg leading-relaxed text-neutral-800 mb-12"
        data-reveal
        data-delay="1"
      >
        Trasportiamo e installiamo tutto ciò che produciamo nel nostro laboratorio.
      </p>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          installTypes.map((item) => (
            <a
              href={item.href}
              class="group rounded-2xl border border-neutral-200 bg-surface p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md"
            >
              <h3 class="font-heading text-lg text-primary group-hover:text-primary-dark">
                {item.name}
              </h3>
              <p class="mt-2 text-sm text-neutral-800">{item.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <h2 class="font-heading text-3xl text-primary text-center sm:text-4xl mb-4" data-reveal>
        Zone servite
      </h2>
      <p
        class="mx-auto mt-4 max-w-2xl text-center text-lg leading-relaxed text-neutral-800"
        data-reveal
        data-delay="1"
      >
        Da Casale Monferrato operiamo in tutto il Nord-Ovest e oltre confine, con sopralluoghi
        gratuiti nelle aree principali.
      </p>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          zones.map((zone, i) => (
            <div data-reveal data-delay={String(i + 1)} class="group pb-1">
              <div class="glass-hover glass-reflect h-full rounded-2xl border border-neutral-200 bg-surface p-8 text-center shadow-sm transition-all duration-200 group-hover:-translate-y-1">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
                  <svg
                    class="h-8 w-8 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    {ICONS[zone.icon].map((d) => (
                      <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                    ))}
                  </svg>
                </div>
                <h3 class="mt-4 font-heading text-xl text-primary">{zone.title}</h3>
                <p class="mt-2 text-neutral-800">{zone.text}</p>
                <span class="mt-3 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
                  {zone.badge}
                </span>
              </div>
            </div>
          ))
        }
      </div>

      <div
        data-reveal
        class="mt-12 rounded-2xl border border-neutral-200 bg-neutral-50 p-6 text-center shadow-sm sm:p-8"
      >
        <p class="reassure-link glass-shine block text-lg text-neutral-800">
          Non sei sicuro che arriviamo da te?
          <strong class="text-primary">Scrivici o chiamaci</strong>, ci organizziamo sempre.
        </p>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-4">
          <ContattaciButton />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-neutral-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <h2 class="font-heading text-3xl text-primary text-center sm:text-4xl mb-4" data-reveal>
        Conformità e garanzie
      </h2>
      <p
        class="mx-auto mt-4 max-w-2xl text-center text-lg leading-relaxed text-neutral-800 mb-12"
        data-reveal
        data-delay="1"
      >
        Trasporto e montaggio eseguiti nel pieno rispetto delle normative italiane vigenti. Ogni
        intervento è a regola d'arte, anche dal punto di vista legale.
      </p>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          guarantees.map((g, i) => (
            <div
              data-reveal
              data-delay={String((i % 3) + 1)}
              class="rounded-2xl border border-neutral-200 bg-surface p-6 shadow-sm"
            >
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 mb-4">
                {g.icon === 'ce' ? (
                  <span
                    class="text-lg font-bold tracking-tight text-primary"
                    aria-label="Marchio CE"
                    role="img"
                  >
                    CE
                  </span>
                ) : (
                  <svg
                    class="h-6 w-6 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    {ICONS[g.icon].map((d) => (
                      <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                    ))}
                  </svg>
                )}
              </div>
              <h3 class="font-heading text-lg text-primary">{g.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-800">{g.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
