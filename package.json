{
  "name": "monferrinaproject",
  "type": "module",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "astro": "astro",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "check:links": "node scripts/check-internal-links.mjs dist/client",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.14",
    "@sentry/astro": "^11.7.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.4",
    "checkly": "^9.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    },
    "minimatch": {
      "brace-expansion": "^5.0.12"
    },
    "@vercel/functions": {
      "ws": "^8.21.0"
    }
  },
  "allowScripts": {
    "esbuild": true
  }
}
